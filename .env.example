# Copia questo file in ".env.local" (resta solo sul tuo Mac, mai su GitHub) e inserisci
# i valori presi da Supabase → Project Settings → Data API / API Keys.

# Per provare il sito sul Mac (npm run dev): indirizzo e chiave PUBBLICA (publishable)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# Solo per creare gli account in blocco (node scripts/crea-account.mjs): chiave SEGRETA.
# Non incollarla mai in chat, email o documenti.
SUPABASE_SERVICE_KEY=sb_secret_...
